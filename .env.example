# Configuración de AbuseIPDB API
ABUSEIPDB_API_KEY=YOUR_API_KEY_HERE

# Configuración de seguridad de Flask
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Configuración de usuario administrador
ADMIN_USERNAME=admin
# Hash de la contraseña (usar generate_password_hash.py)
ADMIN_PASSWORD_HASH=pbkdf2:sha256:600000$randomsalt$hashedpassword

# API Key para monitoreo externo
API_MONITOR_KEY=your-secure-api-monitoring-key-here

# ============================================
# CONFIGURACIÓN DE BASE DE DATOS
# ============================================

# DESARROLLO LOCAL: SQLite (por defecto si no especificas DATABASE_URL)
# DATABASE_URL=sqlite:///verip_stats.db

# DESARROLLO: PostgreSQL Neon (rama develop)
# DATABASE_URL=postgresql://user:password@ep-dev-xxxx.neon.tech/verip_dev?sslmode=require

# PRODUCCIÓN: PostgreSQL Neon (rama main/master)
# DATABASE_URL=postgresql://user:password@ep-prod-yyyy.neon.tech/verip_prod?sslmode=require

# ============================================
# NOTAS IMPORTANTES
# ============================================
# 
# 1. Nunca uses la misma base de datos para dev y producción
# 2. Crea 2 proyectos en Neon o usa Neon Branches
# 3. En GitHub Secrets usa: DATABASE_URL_DEV y DATABASE_URL_PROD
# 4. Para local development, deja DATABASE_URL sin configurar (usará SQLite)
#
