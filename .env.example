# Configuración de AbuseIPDB API
ABUSEIPDB_API_KEY=YOUR_API_KEY_HERE

# Configuración de seguridad de Flask
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Configuración de usuario administrador
ADMIN_USERNAME=admin
# Hash de la contraseña (usar generate_password_hash de werkzeug)
ADMIN_PASSWORD_HASH=pbkdf2:sha256:600000$randomsalt$hashedpassword

# API Key para monitoreo externo
API_MONITOR_KEY=your-secure-api-monitoring-key-here
