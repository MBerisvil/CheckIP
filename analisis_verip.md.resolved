## 🔐 Consideraciones de Seguridad

### Rate Limiting
```python
from flask_limiter import Limiter
from flask_limiter.util import get_remote_address

limiter = Limiter(
    app,
    key_func=get_remote_address,
    default_limits=["10 per day"]  # Free tier
)

@app.route('/verify', methods=['POST'])
@limiter.limit("100 per day", override_defaults=False)  # Pro tier
def verify():
    # ...
```

### API Key Management
```python
import secrets

def generate_api_key():
    return f"vip_{secrets.token_urlsafe(32)}"

@app.route('/api/v1/check/<ip>')
def api_check(ip):
    api_key = request.headers.get('X-API-Key')
    user = validate_api_key(api_key)
    
    if not user:
        return jsonify({'error': 'Invalid API key'}), 401
    
    if not check_rate_limit(user):
        return jsonify({'error': 'Rate limit exceeded'}), 429
    
    return jsonify(verify_ip(ip))
```

